#!/usr/bin/env bash
# edp-watchdog -- keeps the internal laptop panel alive.
#
# Runs as the edp-watchdog systemd user service. Safety net for the i915
# modprobe workaround in hardware/machines/thinkpad-p1-gen7.toml.
#
# Failure modes handled:
#
#   A) Kernel eDP link-training failure
#      "*ERROR* Timeout waiting for DDI BUF A to get active" / "PSR wait
#      timed out" -> panel black, kernel believes it is on.
#      Repair: DPMS off -> on, a full modeset that retrains the link.
#
#   B) Compositor leaves the panel disabled
#      Connector reads "connected" but "enabled=disabled", no kernel error.
#      Seen when KWin reconfigures outputs and drops the internal panel.
#
# Mode B can arrive late: a DisplayLink dock enumerates over USB ~12 s
# after resume, and only then does KWin reconfigure and drop eDP. So:
#   * each trigger opens a 120 s supervision WINDOW; a healthy reading
#     does not end it early
#   * DisplayLink/evdi hotplug counts as a trigger
#   * supervision runs in the background, so the journal reader never
#     blocks and cannot miss events while a repair is in progress
#
# Reading kernel messages needs journal access (wheel, adm, or
# systemd-journal group).
#
# Deliberate "internal screen off" is still respected: with no trigger
# event in the last 120 s the watchdog never touches the output, and it
# gives up after 3 re-enables inside one window (if it keeps getting turned
# off, that is you, not KWin).
#
set -u

source /usr/local/lib/edp-recovery/kscreen.sh

TRIGGER="$XDG_RUNTIME_DIR/edp-watchdog.trigger"
WINDOW=120          # seconds of supervision after a trigger event
POLL=5              # seconds between checks inside the window
MAX_REENABLE=3      # per window; beyond this, assume it is intentional

log() { logger -t edp-watchdog "$*"; }

edp_is_disabled() {
    kdoc -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
        | awk '/^Output:/{cur=($3 ~ /^eDP/)} cur && /^\t*disabled$/{found=1} END{exit !found}'
}

lid_is_open() {
    local s
    for s in /proc/acpi/button/lid/*/state; do
        [[ -r $s ]] && { grep -q open "$s" && return 0 || return 1; }
    done
    return 0    # no lid device readable -> fail safe, prefer a working panel
}

edp_connected() {
    local f
    for f in /sys/class/drm/card*-eDP-*/status; do
        [[ -r $f ]] && [[ $(cat "$f") == connected ]] && return 0
    done
    return 1
}

trip() {   # record a trigger; supervisor picks it up
    date +%s > "$TRIGGER"
}

# ---- Mode A: link-training failure -> full retrain -------------------
last_retrain=0
retrain() {
    local now out
    now=$(date +%s)
    (( now - last_retrain < 30 )) && return 0   # rate limit; failed retrain re-logs
    last_retrain=$now
    sleep 2
    out=$(find_edp)
    [[ -z $out ]] && { log "link failure seen but no eDP output found"; return 0; }
    log "link-training failure detected; retraining $out"
    if edp_retrain 3; then
        log "retrain of $out complete"
    else
        log "retrain of $out failed: DPMS off/on cycle did not complete"
    fi
    trip    # also supervise afterwards, in case KWin drops it again
}

# ---- Mode B: supervisor loop (background) ---------------------------
supervisor() {
    local window_id="" reenables=0 t now out age
    while true; do
        sleep "$POLL"
        [[ -r $TRIGGER ]] || continue
        t=$(cat "$TRIGGER" 2>/dev/null) || continue
        [[ $t =~ ^[0-9]+$ ]] || continue
        now=$(date +%s); age=$(( now - t ))
        (( age > WINDOW )) && continue          # window expired: hands off

        if [[ $t != "$window_id" ]]; then       # new trigger -> new window
            window_id=$t; reenables=0
        fi

        lid_is_open   || continue               # lid shut: panel SHOULD be off
        edp_connected || continue
        edp_is_disabled || continue             # healthy: keep watching, do not exit

        (( reenables >= MAX_REENABLE )) && continue
        out=$(find_edp); [[ -z $out ]] && continue
        reenables=$(( reenables + 1 ))
        log "panel disabled ${age}s after trigger; re-enabling $out [$reenables/$MAX_REENABLE]"
        kdoc "output.$out.enable"
        sleep 2
        if edp_is_disabled; then
            log "re-enable of $out did not stick; will retry"
        else
            log "$out re-enabled successfully"
        fi
    done
}

log "watchdog started (window=${WINDOW}s, triggers: lid/resume/displaylink)"
supervisor &
SUPERVISOR=$!
trap 'kill $SUPERVISOR 2>/dev/null' EXIT

# ---- journal reader: never blocks, just classifies -------------------
journalctl -f -n 0 -o cat -t kernel -t systemd-logind --no-pager | while IFS= read -r line; do
    case "$line" in
        *"Timeout waiting for DDI BUF A to get active"*) retrain ;;
        *"PSR wait timed out"*)                          retrain ;;
        *"Lid opened"*)                                  trip ;;
        *"PM: suspend exit"*)                            trip ;;
        # DisplayLink / evdi hotplug -- KWin reconfigures outputs here and
        # this is where it has been seen to drop the internal panel.
        *"Manufacturer: DisplayLink"*)                   trip ;;
        *"Initialized evdi"*)                            trip ;;
        *"Connector state: connected"*)                  trip ;;
    esac
done
